         /// visible in L2 once the CWD retires it.  NVIDIA's own driver
         /// (libnvidia-eglcore.so 615.78.08) has CWD_MEMBAR_TYPE = L1_MEMBAR
@@ -634,6 +644,65 @@ mod qmd_5_0 {
             set_enum!(bv, clcdc0, QMDV05_00, CWD_MEMBAR_TYPE, L1_MEMBAR);
         }
     }
+
+    /// Dependency fields of a Blackwell B (cec0) QMD, as laid out in
+    /// clcec0qmd.h.  NVIDIA's driver (libnvidia-eglcore.so 615.78.08,
+    /// E 0xd32f60 / E 0xd33340 / E 0xd334a0 / E 0xd33fb0) writes exactly
+    /// these bits: DEPENDENCE_COUNTER, DEPENDENT_QMD{0,1} enable / action /
+    /// prefetch / pointer and the per-QMD cache invalidates.
+    pub mod cec0 {
+        use crate::qmd::*;
+        use nvidia_headers::classes::clcec0::qmd::*;
+
+        pub fn set_dependence_counter(qmd: &mut [u32], counter: u16) {
+            let mut bv = QMDBitView::new(qmd);
+            bv.set_field(QMDV05_00_DEPENDENCE_COUNTER, counter);
+        }
+
+        pub fn set_dependent_qmd(qmd: &mut [u32], slot: usize, addr: u64) {
+            assert!(addr % 256 == 0);
+            let mut bv = QMDBitView::new(qmd);
+            bv.set_field(
+                QMDV05_00_DEPENDENT_QMD_ENABLE(slot),
+                QMDV05_00_DEPENDENT_QMD_ENABLE_TRUE,
+            );
+            bv.set_field(
+                QMDV05_00_DEPENDENT_QMD_ACTION(slot),
+                QMDV05_00_DEPENDENT_QMD_ACTION_QMD_DECREMENT_DEPENDENCE,
+            );
+            bv.set_field(
+                QMDV05_00_DEPENDENT_QMD_PREFETCH(slot),
+                QMDV05_00_DEPENDENT_QMD_PREFETCH_TRUE,
+            );
+            bv.set_field(
+                QMDV05_00_DEPENDENT_QMD_POINTER(slot),
+                u32::try_from(addr >> 8).unwrap(),
+            );
+        }
+
+        pub fn dependent_qmd_enabled(qmd: &mut [u32], slot: usize) -> bool {
+            let bv = QMDBitView::new(qmd);
+            bv.get_bit_range_u64(QMDV05_00_DEPENDENT_QMD_ENABLE(slot)) != 0
+        }
+
+        pub fn set_invalidates(
+            qmd: &mut [u32],
+            texture_data: bool,
+            shader_data: bool,
+            shader_constant: bool,
+        ) {
+            let mut bv = QMDBitView::new(qmd);
+            if texture_data {
+                bv.set_field(QMDV05_00_INVALIDATE_TEXTURE_DATA_CACHE, 1_u32);
+            }
+            if shader_data {
+                bv.set_field(QMDV05_00_INVALIDATE_SHADER_DATA_CACHE, 1_u32);
+            }
+            if shader_constant {
+                bv.set_field(QMDV05_00_INVALIDATE_SHADER_CONSTANT_CACHE, 1_u32);
+            }
+        }
+    }
 }
 use qmd_5_0::Qmd5_0;
 
@@ -794,3 +863,97 @@ pub extern "C" fn nak_get_qmd_cbuf_desc_layout(
         panic!("Unsupported shader model");
     }
 }
+
+/// The QMD words of `qmd` for a class with QMD dependency support (only
+/// Blackwell B for now: the only class whose dependency layout has been
+/// measured on hardware).
+fn dep_qmd<'a>(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+) -> &'a mut [u32] {
+    assert!(
+        dev.cls_compute == clcec0::BLACKWELL_COMPUTE_B,
+        "QMD dependencies are only supported on Blackwell B compute"
+    );
+    assert!(!qmd.is_null());
+    assert!(qmd_size == size_of::<Qmd5_0>());
+    unsafe { std::slice::from_raw_parts_mut(qmd as *mut u32, qmd_size / 4) }
+}
+
+#[no_mangle]
+pub extern "C" fn nak_qmd_set_empty_grid(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+) {
+    // Keep everything of the template and only set CTA 1x1x1 / grid 0,
+    // as the proprietary driver builds its empty QMDs (E 0xd34709).
+    let words = dep_qmd(dev, qmd, qmd_size);
+    let mut q = Qmd5_0::from_words(words);
+    q.set_global_size(0, 0, 0);
+    q.set_local_size(1, 1, 1);
+    words.copy_from_slice(&q.qmd_words());
+}
+
+#[no_mangle]
+pub extern "C" fn nak_qmd_set_dependence_counter(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+    counter: u32,
+) {
+    let counter = u16::try_from(counter)
+        .expect("QMD dependence counter exceeds the 16-bit field");
+    qmd_5_0::cec0::set_dependence_counter(
+        dep_qmd(dev, qmd, qmd_size),
+        counter,
+    );
+}
+
+#[no_mangle]
+pub extern "C" fn nak_qmd_set_dependent_qmd(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+    slot: u32,
+    dep_addr: u64,
+) {
+    assert!(slot < 2);
+    qmd_5_0::cec0::set_dependent_qmd(
+        dep_qmd(dev, qmd, qmd_size),
+        slot as usize,
+        dep_addr,
+    );
+}
+
+#[no_mangle]
+pub extern "C" fn nak_qmd_dependent_qmd_enabled(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+    slot: u32,
+) -> bool {
+    assert!(slot < 2);
+    qmd_5_0::cec0::dependent_qmd_enabled(
+        dep_qmd(dev, qmd, qmd_size),
+        slot as usize,
+    )
+}
+
+#[no_mangle]
+pub extern "C" fn nak_qmd_set_invalidates(
+    dev: &nv_device_info,
+    qmd: *mut ::std::os::raw::c_void,
+    qmd_size: usize,
+    texture_data: bool,
+    shader_data: bool,
+    shader_constant: bool,
+) {
+    qmd_5_0::cec0::set_invalidates(
+        dep_qmd(dev, qmd, qmd_size),
+        texture_data,
+        shader_data,
+        shader_constant,
+    );
+}
