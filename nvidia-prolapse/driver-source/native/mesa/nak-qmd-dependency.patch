+void nak_qmd_set_dependence_counter(const struct nv_device_info *dev,
+                                    void *qmd, size_t qmd_size,
+                                    uint32_t counter);
+void nak_qmd_set_dependent_qmd(const struct nv_device_info *dev,
+                               void *qmd, size_t qmd_size,
+                               uint32_t slot, uint64_t dep_addr);
+bool nak_qmd_dependent_qmd_enabled(const struct nv_device_info *dev,
+                                   void *qmd, size_t qmd_size,
+                                   uint32_t slot);
+void nak_qmd_set_invalidates(const struct nv_device_info *dev,
+                             void *qmd, size_t qmd_size,
+                             bool texture_data, bool shader_data,
+                             bool shader_constant);
+
