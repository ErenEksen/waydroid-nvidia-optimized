nak: CWD_MEMBAR_TYPE = L1_MEMBAR in Blackwell B QMDs

NVIDIA's driver (libnvidia-eglcore.so 615.78.08) launches every Blackwell B (cec0) QMD with
CWD_MEMBAR_TYPE = L1_MEMBAR (QMDV05_00 MW(625:624) = 3, in its QMD template); NAK left it L1_NONE.

diff --git a/src/nouveau/compiler/nak/qmd.rs b/src/nouveau/compiler/nak/qmd.rs
index d91d6a32841f..6b54e7153b94 100644
--- a/src/nouveau/compiler/nak/qmd.rs
+++ b/src/nouveau/compiler/nak/qmd.rs
@@ -7,7 +7,9 @@ use std::cmp::min;
 
 use compiler::bindings::*;
 use nak_bindings::*;
-use nvidia_headers::classes::{cla0c0, clc0c0, clc3c0, clc6c0, clcbc0, clcdc0};
+use nvidia_headers::classes::{
+    cla0c0, clc0c0, clc3c0, clc6c0, clcbc0, clcdc0, clcec0,
+};
 
 use bitview::*;
 use paste::paste;
@@ -621,6 +623,17 @@ mod qmd_5_0 {
         qmd_impl_set_smem_size_bounded_gb!(clcdc0, QMDV05_00);
         qmd_impl_set_slm_size!(clcdc0, QMDV05_00, SHIFTED4);
     }
+
+    impl Qmd5_0 {
+        /// L1 membar when each CTA completes, so the grid's stores are
+        /// visible in L2 once the CWD retires it.  NVIDIA's own driver
+        /// (libnvidia-eglcore.so 615.78.08) has CWD_MEMBAR_TYPE = L1_MEMBAR
+        /// in every Blackwell B (cec0) QMD it launches, Vulkan and GL.
+        pub fn set_cwd_membar_l1(&mut self) {
+            let mut bv = QMDBitView::new(&mut self.qmd);
+            set_enum!(bv, clcdc0, QMDV05_00, CWD_MEMBAR_TYPE, L1_MEMBAR);
+        }
+    }
 }
 use qmd_5_0::Qmd5_0;
 
@@ -707,7 +720,12 @@ pub extern "C" fn nak_fill_qmd(
         if dev.cls_compute >= clcdc0::BLACKWELL_COMPUTE_A {
             let qmd_out = qmd_out as *mut Qmd5_0;
             assert!(qmd_size == size_of_val(&*qmd_out));
-            qmd_out.write(fill_qmd(dev, info, qmd_info));
+            let mut qmd: Qmd5_0 = fill_qmd(dev, info, qmd_info);
+            // Known for Blackwell B only; Blackwell A keeps L1_NONE.
+            if dev.cls_compute >= clcec0::BLACKWELL_COMPUTE_B {
+                qmd.set_cwd_membar_l1();
+            }
+            qmd_out.write(qmd);
         } else if dev.cls_compute >= clcbc0::HOPPER_COMPUTE_A {
             let qmd_out = qmd_out as *mut Qmd4_0;
