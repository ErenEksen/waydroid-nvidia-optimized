# Pinned inputs for hwcomposer.waydroid.so (hwcomposer/provision.sh + hwcomposer/build.sh).
# Sourced by bash. Every value is a commit SHA or a sha256-checked download.

# hwcomposer source: waydroid/android_hardware_waydroid lineage-20 at a3e4239 (2026-10-18, "call
# setFocusedTask without holding windowsMutex"; the vendor image pins the same commit), our patches/ on top.
HWC_UPSTREAM=https://github.com/waydroid/android_hardware_waydroid
HWC_SHA=a3e42399afbd23613f123a28bda658a4c6c1faec

# NDK: r29, the one the baseline built the 2026-07-28 prebuilt with (.note.android.ident
# "r29 14206865"). sha256 from packaging/ci/pins.env.
NDK_VERSION=r29
NDK_URL=https://dl.google.com/android/repository/android-ndk-r29-linux.zip
NDK_ZIP_SHA256=4abbbcdc842f3d4879206e9695d52709603e52dd68d3c1fff04b3b5e7a308ecf

# AOSP header repos (android-13 era, the image's ABI), shallow-fetched at these commits.
# Same values the former packaging/ci/hwc-pins.env carried.
AOSP_BASE=https://android.googlesource.com/platform
AOSP_FMQ_SHA=e743e9f3f496ec757eda5fcd78417567cd3040f2
AOSP_FMTLIB_SHA=2408feea0803c118beaf7c627ab876788b030e9f
AOSP_FRAMEWORKS_NATIVE_SHA=22e08d27a0f593a1a4920cd90cca935ed1cc7abb
AOSP_HARDWARE_INTERFACES_SHA=ae23313a6e047383d13aa4435ec813afbfe61ebe
AOSP_HIDL_SHA=15655b575b1f1c6a00aa483b5c3a6469c2cc969e
AOSP_LIBBASE_SHA=bfc09f25369d843d67fe7929cff62af3842c9c24
AOSP_LIBHARDWARE_SHA=a85695ed3fb6308a6daa14c303218b89940e36c2
AOSP_LIBHIDL_SHA=b7e1131f4a5ba090c188126c017069a0f4fb63d6
AOSP_LIBHWBINDER_SHA=66f259a545c8b349dcf4bdfe27e3f0b04be79b13
AOSP_SYSTEM_CORE_SHA=88a4c62d2cdfb84e27ae207986429a30979cd790
# liblog for the host hidl-gen build (LineageOS mirror)
SYSTEM_LOGGING_URL=https://github.com/LineageOS/android_system_logging
SYSTEM_LOGGING_SHA=373d54e772f303c441faf2e584a2edf3601b4181
# minigbm (cros_gralloc handle layout), the baseline's MINIGBM_SHA
MINIGBM_UPSTREAM=https://github.com/waydroid/android_external_minigbm.git
MINIGBM_SHA=16844babfbd83d7c206ca22256257cbf26ca7de1

# Tarball sha256s were recorded on first download over TLS (2026-10-12), libffi matches upstream release notes.
# Static guest-side deps, cross-built for bionic with the pinned NDK (API 30, as the baseline)
LIBFFI_VERSION=3.4.6
LIBFFI_URL=https://github.com/libffi/libffi/releases/download/v3.4.6/libffi-3.4.6.tar.gz
LIBFFI_SHA256=b0dea9df23c863a7a50e825440f3ebffabd65df1497108e5d437747843895a4e
WAYLAND_VERSION=1.25.0
WAYLAND_URL=https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.25.0/downloads/wayland-1.25.0.tar.xz
WAYLAND_SHA256=c065f040afdff3177680600f249727e41a1afc22fccf27222f15f5306faa1f03
XKBCOMMON_VERSION=1.7.0
XKBCOMMON_URL=https://xkbcommon.org/download/libxkbcommon-1.7.0.tar.xz
XKBCOMMON_SHA256=65782f0a10a4b455af9c6baab7040e2f537520caa2ec2092805cdfd36863b247
LIBDRM_VERSION=2.4.133
LIBDRM_URL=https://dri.freedesktop.org/libdrm/libdrm-2.4.133.tar.xz
LIBDRM_SHA256=fc68f9d0ba2ea63c9432a299e14fea09fad7a8a66e8039fcd7802ca59f77b4f5
# Protocol XMLs for the generated wayland glue (scanner = the native 1.25.0 built from WAYLAND_URL).
# 1.49 regenerates the baseline's committed gen/*.c|h byte for byte.
WAYLAND_PROTOCOLS_VERSION=1.49
WAYLAND_PROTOCOLS_URL=https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/1.49/downloads/wayland-protocols-1.49.tar.xz
WAYLAND_PROTOCOLS_SHA256=ec4c8f74942d6dff7ace8b4ce4764f0ef9ff618a935d974ea77edee2ad240b14

# Link-time .so stubs (vendor.waydroid.* HIDL libs, system/vndk libs): from the local Waydroid
# images (waydroid.cfg images_path) or, if absent, these OTA zips: the guest image this repo targets
# (2026-10-16: lineage-20.0 20260927 GAPPS system + MAINLINE vendor; sha256 = the ota.waydro.id JSON id,
# re-checked on download).
IMG_SYSTEM_URL=https://sourceforge.net/projects/waydroid/files/images/system/lineage/waydroid_x86_64/lineage-20.0-20260927-GAPPS-waydroid_x86_64-system.zip/download
IMG_SYSTEM_SHA256=1d79df0b17ab8f79d66fd3b5f94500cc02f1abe149cf8caa391380092ede6e2a
IMG_VENDOR_URL=https://sourceforge.net/projects/waydroid/files/images/vendor/waydroid_x86_64/lineage-20.0-20260927-MAINLINE-waydroid_x86_64-vendor.zip/download
IMG_VENDOR_SHA256=d911b8353f6c807b94790b1c41c67e863a9f3dcd1cf3ec0232351398235afd7a
# Second entry points to the same SourceForge files (each redirects to a mirror of its own choosing; no other host
# publishes these images). tools/fetch.py gives up a stalled or trickling mirror and tries these next.
IMG_SYSTEM_URL_ALT=https://downloads.sourceforge.net/project/waydroid/images/system/lineage/waydroid_x86_64/lineage-20.0-20260927-GAPPS-waydroid_x86_64-system.zip
IMG_VENDOR_URL_ALT=https://downloads.sourceforge.net/project/waydroid/images/vendor/waydroid_x86_64/lineage-20.0-20260927-MAINLINE-waydroid_x86_64-vendor.zip
