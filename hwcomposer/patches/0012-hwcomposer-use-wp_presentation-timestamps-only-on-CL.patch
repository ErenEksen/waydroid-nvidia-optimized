From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: waydroid-nvidia-prolapse <build@local>
Date: Mon, 12 Oct 2026 01:00:55 +0300
Subject: [PATCH 12/20] hwcomposer: use wp_presentation timestamps only on
 CLOCK_MONOTONIC

What:
- The display records wp_presentation.clock_id; feedback_presented() updates
  last_vsync_ns only when it is CLOCK_MONOTONIC (logged at start: info when
  it is, warning when it is not).
- time_to_sleep_to_next_vsync() handles a last_vsync_ns later than the
  vsync thread's clock read (sleeps to it, at most one period) and a zero
  period; nanosecond conversions use integer arithmetic (the old `* 1e9`
  went through double, 53-bit mantissa, ~256 ns steps at today's uptimes).

Why: the vsync thread compares last_vsync_ns with CLOCK_MONOTONIC. A
compositor reporting another clock (wp_presentation allows any, e.g.
CLOCK_REALTIME) put last_vsync_ns decades ahead, `now - last_vsync_ns`
wrapped, the sleep was garbage, and Choreographer stalled (source report).
KWin 6.7.5 reports CLOCK_MONOTONIC (measured 2026-10-12 with a host
wp_presentation client: clock_id=1), so on KWin this changes nothing.

Source: QuinOvaX, quinovax/waydroid-nvidia main f2c2f39
  https://github.com/quinovax/waydroid-nvidia/commit/f2c2f3924451b84b4f23a0190121953322645dc7
Licence: Apache-2.0 (android_hardware_waydroid; the fork's patches/hwcomposer/
inherit it).
Deviations: clock id is an atomic (written on the Wayland thread, read in
the feedback handler); a future timestamp sleeps min(gap, period) instead of
the source's "period if more than 4 periods ahead".
---
 hwcomposer/hwcomposer.cpp  | 22 ++++++++++++++++++----
 hwcomposer/wayland-hwc.cpp | 11 +++++++++--
 hwcomposer/wayland-hwc.h   |  4 ++++
 3 files changed, 31 insertions(+), 6 deletions(-)

diff --git a/hwcomposer/hwcomposer.cpp b/hwcomposer/hwcomposer.cpp
index 7a1916c..c58d58b 100644
--- a/hwcomposer/hwcomposer.cpp
+++ b/hwcomposer/hwcomposer.cpp
@@ -257,9 +257,20 @@ static int hwc_prepare(hwc_composer_device_1_t* dev,
     return 0;
 }
 
+static uint64_t timespec_to_ns(const struct timespec *ts)
+{
+    return (uint64_t)ts->tv_sec * 1000000000ull + (uint64_t)ts->tv_nsec;
+}
+
 static long time_to_sleep_to_next_vsync(struct timespec *rt, uint64_t last_vsync_ns, unsigned vsync_period_ns)
 {
-    uint64_t now = (uint64_t)rt->tv_sec * 1e9 + rt->tv_nsec;
+    uint64_t now = timespec_to_ns(rt);
+    if (vsync_period_ns == 0)
+        vsync_period_ns = 16666666;
+    /* A presented timestamp can lie after the vsync thread's clock read; now - last_vsync_ns
+     * would then wrap to ~2^64 and the computed sleep would be garbage. Sleep to that vsync. */
+    if (now < last_vsync_ns)
+        return (long)std::min<uint64_t>(last_vsync_ns - now, vsync_period_ns);
     uint64_t frames_since_last_vsync = (now - last_vsync_ns) / vsync_period_ns + 1;
     uint64_t next_vsync = last_vsync_ns + frames_since_last_vsync * vsync_period_ns;
 
@@ -307,7 +318,7 @@ static void* hwc_vsync_thread(void* data) {
             continue;
         }
 
-        int64_t timestamp = (uint64_t)rt.tv_sec * 1e9 + rt.tv_nsec;
+        int64_t timestamp = (int64_t)timespec_to_ns(&rt);
         pdev->procs->vsync(pdev->procs, 0, timestamp);
         ATRACE_END();
     }
@@ -335,7 +346,10 @@ feedback_presented(void *data,
     auto *pdev = static_cast<waydroid_hwc_composer_device_1 *>(data);
     wp_presentation_feedback_destroy(feedback);
 
-    pdev->last_vsync_ns = (((uint64_t)tv_sec_hi << 32) + tv_sec_lo) * 1e9 + tv_nsec;
+    /* last_vsync_ns is compared with CLOCK_MONOTONIC (hwc_vsync_thread) */
+    if (!pdev->display || pdev->display->presentation_clk_id != CLOCK_MONOTONIC)
+        return;
+    pdev->last_vsync_ns = ((((uint64_t)tv_sec_hi << 32) + tv_sec_lo) * 1000000000ull) + tv_nsec;
 }
 
 static void
@@ -990,7 +1004,7 @@ static int hwc_open(const struct hw_module_t* module, const char* name,
             __FILE__, __LINE__, strerror(errno));
     }
 
-    pdev->last_vsync_ns = int64_t(rt.tv_sec) * 1e9 + rt.tv_nsec;
+    pdev->last_vsync_ns = timespec_to_ns(&rt);
 
     if (!pdev->vsync_thread) {
         ret = pthread_create (&pdev->vsync_thread, NULL, hwc_vsync_thread, pdev);
diff --git a/hwcomposer/wayland-hwc.cpp b/hwcomposer/wayland-hwc.cpp
index 7f8f3f2..2ad322b 100644
--- a/hwcomposer/wayland-hwc.cpp
+++ b/hwcomposer/wayland-hwc.cpp
@@ -1888,10 +1888,17 @@ static const struct wl_output_listener output_listener = {
 };
 
 static void
-presentation_clock_id(void *, struct wp_presentation *,
+presentation_clock_id(void *data, struct wp_presentation *,
               uint32_t clk_id)
 {
-    ALOGE("*** %s: clk_id %d CLOCK_MONOTONIC %d", __func__, clk_id, CLOCK_MONOTONIC);
+    auto *d = static_cast<struct display *>(data);
+    d->presentation_clk_id = clk_id;
+    if (clk_id == CLOCK_MONOTONIC)
+        ALOGI("wp_presentation clock_id %u (CLOCK_MONOTONIC): vsync follows presentation feedback",
+              clk_id);
+    else
+        ALOGW("wp_presentation clock_id %u is not CLOCK_MONOTONIC (%d): presentation timestamps "
+              "are ignored and vsync runs on the hwcomposer's own period", clk_id, CLOCK_MONOTONIC);
 }
 
 static const struct wp_presentation_listener presentation_listener = {
diff --git a/hwcomposer/wayland-hwc.h b/hwcomposer/wayland-hwc.h
index 290dea2..2247094 100644
--- a/hwcomposer/wayland-hwc.h
+++ b/hwcomposer/wayland-hwc.h
@@ -372,6 +372,10 @@ struct display {
     struct wl_touch *touch;
     struct wl_output *output;
     struct wp_presentation *presentation;
+    /* wp_presentation.clock_id (UINT32_MAX until the compositor sends it). Presentation
+     * timestamps feed last_vsync_ns, which the vsync thread compares with CLOCK_MONOTONIC, so
+     * they are used only when the compositor's clock is CLOCK_MONOTONIC. */
+    std::atomic<uint32_t> presentation_clk_id{UINT32_MAX};
     struct wp_viewporter *viewporter;
     struct android_wlegl *android_wlegl;
     struct zwp_linux_dmabuf_v1 *dmabuf;
