From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nvidia-prolapse <nvidia-prolapse@localhost>
Date: Fri, 16 Oct 2026 19:55:46 +0300
Subject: [PATCH 5/5] gbm_mesa: import into the wrapper on the first CPU map,
 whatever the allocation usage

Applies to https://github.com/waydroid/android_external_minigbm
16844babfbd83d7c206ca22256257cbf26ca7de1 ("gralloc: Handle PixelFormat::R_8"),
after 0001..0004.

gbm_mesa_bo_import() created the wrapper bo (the object every CPU map goes
through) only when the handle's use_flags had a SW bit. Those flags are the
usage the buffer was *allocated* with. A buffer allocated for GPU or codec use
only, such as a hardware decoder's NV12/P010 output block (usage
VIDEO_DECODER), therefore had no gbm_bo in an importing process, and the
first CPU lock there aborted on assert(priv->gbm_bo != nullptr) in
gbm_mesa_bo_map(). CCodec does exactly that in ByteBuffer mode: it copies each
output GraphicBlock through C2AllocationGralloc::map -> lockYCbCr ->
IMapper::lock.

Gralloc does not tie a lock's CPU usage to the allocation usage (minigbm's
cros_gralloc lock path has no such check either), so the import is now
driven by the map itself: the first map of a bo in a process imports it,
with the layout that drv_bo_import() recorded in bo->meta (the import-time
path ran before drv_bo_import filled in strides and total_size, so the R8
carrier was imported with width 0). drv_bo_map() holds drv->mappings_lock
around bo_map, which serializes the lazy import. A process that never maps
a buffer still never loads the wrapper for it. A failed driver setup or
import is logged with the buffer's layout and returns MAP_FAILED (lock
fails with an error) instead of an assert or a NULL dereference.
---
 gbm_mesa_driver/gbm_mesa_internals.cpp | 89 +++++++++++++++++++-------
 1 file changed, 65 insertions(+), 24 deletions(-)

diff --git a/gbm_mesa_driver/gbm_mesa_internals.cpp b/gbm_mesa_driver/gbm_mesa_internals.cpp
index 72db98c..136f9e7 100644
--- a/gbm_mesa_driver/gbm_mesa_internals.cpp
+++ b/gbm_mesa_driver/gbm_mesa_internals.cpp
@@ -33,6 +33,7 @@ extern "C" {
 #include <cutils/properties.h>
 #include <dlfcn.h>
 #include <errno.h>
+#include <inttypes.h>
 #include <fcntl.h>
 #include <gbm.h>
 #include <glob.h>
@@ -520,29 +521,13 @@ int gbm_mesa_bo_import(struct bo *bo, struct drv_import_fd_data *data)
 		priv->fds[plane] = UniqueFd(dup(data->fds[plane]));
 	}
 
-	if (data->use_flags & BO_USE_SW_MASK) {
-		// Mapping require importing by gbm_mesa
-		auto drv = gbm_mesa_get_or_init_driver(bo->drv, true);
-		auto wr = drv->wrapper;
-
-		uint32_t s_format = data->format;
-		int s_height = data->height;
-		int s_width = data->width;
-		if (wr->get_gbm_format(s_format) == 0) {
-			s_width = bo->meta.total_size;
-			s_height = 1;
-			s_format = DRM_FORMAT_R8;
-		}
-		if (s_format == DRM_FORMAT_YVU420_ANDROID) {
-			s_width /= 2;
-			s_height += data->height / 2;
-			s_width = ALIGN(s_width, 512);
-		}
-		priv->drv = drv;
-		priv->gbm_bo = wr->import(drv->gbm_dev, data->fds[0], s_width, s_height,
-					  data->strides[0], data->format_modifier, s_format);
-	}
-
+	/*
+	 * The wrapper bo that CPU maps go through is imported on the first map
+	 * (gbm_mesa_bo_wrapper_import), not here: a client may lock any buffer
+	 * for CPU access, whatever usage the allocator recorded in the handle,
+	 * and bo->meta (strides, modifier, total_size) is only filled in by
+	 * drv_bo_import after this returns.
+	 */
 	bo->priv = priv;
 
 	gbm_mesa_inode_to_handle(bo);
@@ -564,15 +549,71 @@ int gbm_mesa_bo_get_plane_fd(struct bo *bo, size_t plane)
 	return dup(((GbmMesaBoPriv *)bo->priv)->fds[plane].Get());
 }
 
+/*
+ * Import the buffer into the wrapper for CPU access, once per bo, on its first
+ * map. Upstream imported only when the handle's use_flags (the usage the
+ * buffer was *allocated* with) contained a SW bit, so a buffer allocated for
+ * GPU/codec use only (a hardware decoder's output block) had no gbm_bo in an
+ * importing process and its first lock hit the assert in gbm_mesa_bo_map:
+ * e.g. CCodec copying decoded NV12 GraphicBlocks into ByteBuffers through
+ * lockYCbCr. Gralloc does not tie a lock's CPU usage to the allocation usage,
+ * so the import is driven by the map itself. Processes that never map a
+ * buffer still never load the wrapper for it. Called from drv_bo_map with
+ * drv->mappings_lock held, which serializes this per process.
+ */
+static int gbm_mesa_bo_wrapper_import(struct bo *bo, const std::shared_ptr<GbmMesaDriver> &drv)
+{
+	auto priv = (GbmMesaBoPriv *)bo->priv;
+	if (priv->gbm_bo)
+		return 0;
+
+	auto wr = drv->wrapper;
+	uint32_t s_format = bo->meta.format;
+	int s_width = bo->meta.width;
+	int s_height = bo->meta.height;
+	if (wr->get_gbm_format(s_format) == 0) {
+		/* formats the wrapper does not allocate live on the R8 carrier (bo_create) */
+		s_width = bo->meta.total_size;
+		s_height = 1;
+		s_format = DRM_FORMAT_R8;
+	}
+	if (s_format == DRM_FORMAT_YVU420_ANDROID) {
+		/* upstream e5a7769 "Fix YVU420 format": the chroma planes ride below luma */
+		s_width /= 2;
+		s_height += bo->meta.height / 2;
+		s_width = ALIGN(s_width, 512);
+	}
+
+	priv->gbm_bo = wr->import(drv->gbm_dev, priv->fds[0].Get(), s_width, s_height,
+				  bo->meta.strides[0], bo->meta.format_modifier, s_format);
+	if (priv->gbm_bo == nullptr) {
+		drv_loge("'%s' cannot import %.4s %ux%u (modifier 0x%016" PRIx64
+			 ", stride %u, %" PRIu64 " bytes) for CPU access",
+			 GBM_WRAPPER_NAME, (const char *)&bo->meta.format, bo->meta.width,
+			 bo->meta.height, bo->meta.format_modifier, bo->meta.strides[0],
+			 (uint64_t)bo->meta.total_size);
+		return -EINVAL;
+	}
+	priv->drv = drv;
+	return 0;
+}
+
 void *gbm_mesa_bo_map(struct bo *bo, struct vma *vma, size_t plane, uint32_t map_flags)
 {
 	auto drv = gbm_mesa_get_or_init_driver(bo->drv, true);
+	if (drv == nullptr) {
+		drv_loge("Failed to init gbm driver: cannot map %.4s %ux%u",
+			 (const char *)&bo->meta.format, bo->meta.width, bo->meta.height);
+		return MAP_FAILED;
+	}
 	auto wr = drv->wrapper;
 
 	vma->length = bo->meta.total_size;
 
+	if (gbm_mesa_bo_wrapper_import(bo, drv))
+		return MAP_FAILED;
+
 	auto priv = (GbmMesaBoPriv *)bo->priv;
-	assert(priv->gbm_bo != nullptr);
 
 	void *buf = MAP_FAILED;
 
