#!/usr/bin/env bash
# Explicit restart/health/measurement convenience, NOT an unbacked component deploy.
source "$(dirname "$(readlink -f "$0")")/env.sh"
[[ "${1:-}" == none && $# -gt 1 ]] || die 'usage: dev/iter none --output DIR --desktop-output OUTPUT [benchmark options]; install coupled changes with dev/install-bundle first'
shift
# Require measurement destinations before touching the running stack.
[[ " $* " == *' --output '* && " $* " == *' --desktop-output '* ]] || die 'explicit --output and --desktop-output required'
need_sudo
"$REPO/dev/restart"
"$REPO/dev/health"
exec "$REPO/dev/bench-startup" "$@"
