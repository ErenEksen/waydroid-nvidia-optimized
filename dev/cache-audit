#!/usr/bin/env python3
"""Read-only cache metadata audit. Never clears app data or shader caches."""
import argparse
import json
from pathlib import Path
import time
from perf.runtime import guest, run
p = argparse.ArgumentParser(description=__doc__)
p.add_argument("--guest", action="store_true", help="inspect Android cache metadata (requires sudo authentication)")
a = p.parse_args()
roots = [Path.home()/".cache/nvidia", Path.home()/".nv", Path.home()/".cache/waydroid-nvidia"]
report = {"timestamp_ns": time.time_ns(), "host": [], "guest": None}
for root in roots:
    files = []
    if root.is_dir():
        for f in root.rglob("*"):
            try:
                if f.is_file() and not f.is_symlink():
                    st = f.stat()
                    files.append({"path": str(f.relative_to(root)), "bytes": st.st_size, "mtime_ns": st.st_mtime_ns,
                                  "uid": st.st_uid, "mode": oct(st.st_mode & 0o777)})
            except OSError:
                continue
    report["host"].append({"root": str(root), "files": files})
report["renderer_environment"] = run(["systemctl", "--user", "show", "wd-venus.service", "-p", "Environment", "--value"], check=False).stdout.strip()
if a.guest:
    # Paths and permissions only; no cached shaders, user content or app databases.
    report["guest"] = guest("find /data/misc /data/user_de/0 /data/user/0 -maxdepth 4 \\( -iname '*shader*' -o -iname '*pipeline*' -o -name 'com.android.opengl.shaders_cache' -o -name 'com.android.skia.shaders_cache' \\) -exec ls -ldn {} \\; 2>/dev/null", timeout=60)
print(json.dumps(report, indent=2))
