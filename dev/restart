#!/usr/bin/env bash
# Controlled full restart; errors must not be hidden by sleeps or `|| true`.
source "$(dirname "$(readlink -f "$0")")/env.sh"
need_sudo
say "stopping session and container"
"${WAYDROID[@]}" session stop
if systemctl --user is-active --quiet "$SESSION_UNIT"; then
    systemctl --user stop "$SESSION_UNIT"
fi
sudo -n systemctl stop "$CONTAINER_UNIT"
say "restarting renderer"
systemctl --user restart "$VENUS_UNIT"
for ((i=0; i<100; i++)); do
    [[ -S /run/waydroid-venus/venus.sock ]] && break
    sleep 0.1
done
[[ -S /run/waydroid-venus/venus.sock ]] || die 'renderer socket not ready'
sudo -n systemctl start "$CONTAINER_UNIT"
if [[ -n $(systemctl --user show "$SESSION_UNIT" -p FragmentPath --value) && $(systemctl --user show "$SESSION_UNIT" -p Transient --value) != yes ]]; then
    systemctl --user start "$SESSION_UNIT"
else
systemd-run --user --unit="${SESSION_UNIT%.service}" --collect \
    --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
    --setenv=XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}" \
    "${WAYDROID[@]}" session start
fi
for ((i=0; i<120; i++)); do
    if [[ $("${WAYDROID[@]}" prop get sys.boot_completed 2>/dev/null | tr -d '\r') == 1 ]]; then
        say 'Android booted'
        # Benchmarks request a boot without launching UI or pre-warming apps.
        [[ ${NVWD_NO_UI:-0} == 1 ]] || "${WAYDROID[@]}" show-full-ui
        exit 0
    fi
    sleep 1
done
die 'Android did not boot within 120 seconds'
