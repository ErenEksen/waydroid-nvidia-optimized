post_install() {
    cat <<'MSG'
waydroid-nvidia-optimized: next steps
  Venus mode (this fork's optimized path; open NVIDIA kernel module, driver 580 or newer):
    systemctl --user enable --now wd-venus.service
    sudo waydroid-nvidia-setup --mode venus      (add -s GAPPS for Google apps on a fresh install)
    log out and back in once (the /dev/udmabuf access rule), then: waydroid session start
  Default mode (nvidia-prolapse, upstream's NVK driver) instead:
    sudo waydroid-nvidia-setup                   (tests the vendor image on your GPU, then installs it)
Requires nvidia-drm.modeset=1. Upstream release assets in this package can be verified with
  gh attestation verify <asset> --repo Shiro836/waydroid-nvidia
MSG
}

post_upgrade() {
    echo "waydroid-nvidia-optimized: run 'sudo waydroid-nvidia-setup' again (it re-gates this release's vendor image)"
    echo "waydroid-nvidia-optimized: Venus mode: 'systemctl --user restart wd-venus.service' starts the new renderer"
}

pre_remove() {
    # put the official vendor image back and return waydroid.cfg to stock Waydroid while the setup still exists
    if grep -qx 'nvidia_prolapse_install = vendor-image' /var/lib/waydroid/waydroid.cfg 2>/dev/null; then
        /usr/bin/waydroid-nvidia-setup --restore-official-vendor ||
            echo "waydroid-nvidia-optimized: could not restore the official vendor image (see above); run 'sudo waydroid init -f' after the removal"
    fi
    # the container unit drop-in written by the setup points at tools this package removes
    local dropin=/etc/systemd/system/waydroid-container.service.d/source-native.conf
    if [ -f "$dropin" ] && grep -q /usr/lib/waydroid-nvidia/native "$dropin"; then
        rm -f "$dropin"
        systemctl daemon-reload 2>/dev/null || true
        echo "waydroid-nvidia-optimized: removed $dropin"
    fi
}

post_remove() {
    cat <<'MSG'
waydroid-nvidia-optimized: gate logs and old staged driver roots stay on disk; remove them with
  sudo rm -rf /var/lib/waydroid-nvidia /var/lib/waydroid/nvidia-source-native-* /var/lib/waydroid/nvidia-prolapse
MSG
}
