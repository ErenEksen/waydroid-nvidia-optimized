# Binary inputs of ./install.sh, pinned with this source tree. Every file must match its line in
# packaging/releases/SHA256SUMS (next to this file) before it is used; the URLs of one list carry identical
# bytes and are tried in order.

# Base: the waydroid-nvidia release this tree merged (upstream public-test at v0.2.0-rc12). Its CI built the
# native bundle from BASE_COMMIT, an ancestor of this tree; the scripts installed from this tree are that
# commit's (the fork changes only Venus components, dev tooling and docs).
BASE_TAG=v0.2.0-rc12
BASE_COMMIT=788728d3d51cd64ee8a71a2ce7670a96f935cbab
BASE_PROVENANCE_REPO=Shiro836/waydroid-nvidia     # Sigstore identity: its build.yml at BASE_TAG
BASE_URLS=(https://github.com/ErenEksen/waydroid-nvidia-optimized/releases/download/base-v0.2.0-rc12
           https://github.com/Shiro836/waydroid-nvidia/releases/download/v0.2.0-rc12)

# Overlay: this fork's optimized Venus host renderer, guest Venus drivers (x86, x86_64) and gralloc backend
# (dev/make-bundle layout, packaging/releases/extract-bundle.py)
OVERLAY=waydroid-nvidia-optimized-perf-v1.tar.gz
OVERLAY_URLS=(https://github.com/ErenEksen/waydroid-nvidia-optimized/releases/download/perf-v1)
